{
  "name": "zarvis-desktop",
  "productName": "Zarvis",
  "version": "0.4.0",
  "description": "Zarvis als klein venster dat boven je andere werk zweeft.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bouw:win": "node bouw-installatie.js",
    "bouw:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "be.zolderpunt.zarvis",
    "productName": "Zarvis",
    "files": [
      "main.js",
      "preload.js",
      "preload-whatsapp.js",
      "preload-beheer.js",
      "offline.html",
      "whatsapp.html",
      "whatsapp.js",
      "whatsapp-vertaal.js"
    ],
    "win": {
      "target": "dir"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Zarvis luistert naar je stem als je de microfoon aanzet."
      }
    }
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "qrcode": "^1.5.4"
  }
}
